# Vault Configuration
# Path to your Obsidian vault root (the directory containing Bookmarks/ and Meta/)
VAULT_PATH=

# Optional: override derived paths
# BOOKMARKS_DIR=/path/to/vault/Bookmarks
# BOOKMARK_SEARCH_INDEX=/path/to/vault/Meta/bookmark-search.sqlite3
# BOOKMARK_CONFIG_FILE=/path/to/vault/Meta/bookmark-tools.toml

# LLM Provider Configuration
# Choose between 'openai' or 'openrouter'. If OPENROUTER_API_KEY is set and
# OPENAI_API_KEY is not set, provider defaults to openrouter.
LLM_PROVIDER=openrouter

# API Configuration (optional; without a key, creation falls back to heuristics
# and semantic search/embedding rebuilds are unavailable)
OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Chat model configuration
# Legacy MODEL_ID is still supported; BOOKMARK_CLASSIFICATION_MODEL is preferred.
BOOKMARK_CLASSIFICATION_MODEL=openai/gpt-4.1-mini
# BOOKMARK_SUMMARY_MODEL=openai/gpt-4.1-mini

# Embedding configuration
BOOKMARK_EMBEDDING_MODEL=text-embedding-3-small
BOOKMARK_EMBEDDING_DIMENSIONS=256

# Provider timeouts
BOOKMARK_REQUEST_TIMEOUT=20
BOOKMARK_SUMMARY_TIMEOUT=180
